{
  "name": "payetavie-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "mkdir -p node_modules/nativewind/node_modules && ln -sf ../../../apps/mobile/node_modules/tailwindcss node_modules/nativewind/node_modules/tailwindcss 2>/dev/null || true",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@payetavie/web",
    "dev:mobile": "turbo run dev --filter=@payetavie/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "supabase:deploy": "supabase functions deploy send-reminder-notifications",
    "supabase:link": "supabase link --project-ref",
    "supabase:test": "supabase functions serve send-reminder-notifications"
  },
  "devDependencies": {
    "ajv": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5"
  },
  "overrides": {
    "ajv": "^8.0.0"
  }
}
